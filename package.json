{
  "name": "fernwell",
  "version": "0.4.0",
  "description": "Fernwell — the HunnyDo design system. Design tokens, CSS components, and small vanilla JS enhancers that work in any web app, with or without a build step.",
  "type": "module",
  "license": "MIT",
  "author": "Jacob Knaack",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobKnaack/fernwell.git"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "css",
    "ui",
    "components",
    "hunnydo",
    "fernwell"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/fernwell.cjs",
  "module": "./dist/fernwell.esm.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/fernwell.css",
  "unpkg": "./dist/fernwell.iife.js",
  "jsdelivr": "./dist/fernwell.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fernwell.esm.js",
      "require": "./dist/fernwell.cjs"
    },
    "./css": "./dist/fernwell.css",
    "./css/min": "./dist/fernwell.min.css",
    "./tokens.css": "./dist/fernwell.tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "lint": "node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run tokens && npm run lint && node scripts/build.mjs && tsc -p tsconfig.build.json",
    "docs": "serve docs/",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
